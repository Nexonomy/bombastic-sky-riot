# Server-only: add these through Vercel Storage -> Upstash Redis.
# Never prefix either value with VITE_. Never commit a populated .env file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional. Production and preview use separate namespaces by default.
LEADERBOARD_NAMESPACE=
# Optional exact origin, e.g. https://your-game.vercel.app
PUBLIC_ORIGIN=
