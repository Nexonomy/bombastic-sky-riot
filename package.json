{
  "name": "bombastic",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && node scripts/build-server.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/build-server.mjs && vitest run",
    "start": "node server-dist/index.mjs",
    "dev:server": "node scripts/build-server.mjs && node server-dist/index.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@upstash/redis": "^1.39.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "22.x"
  }
}
